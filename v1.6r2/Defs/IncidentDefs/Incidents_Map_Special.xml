<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<IncidentTargetTagDef>
		<defName>ShashlichnikMap_Cave</defName>
	</IncidentTargetTagDef>
	
	<!--Raids-->
	
	<IncidentDef>
		<defName>ShashlichnikCaveRaid</defName>
		<label>enemy raid</label>
		<workerClass>Shashlichnik.IncidentWorker_CaveRaid</workerClass>
		<!--<workerClass>IncidentWorker_RaidEnemy</workerClass>-->
		<targetTags>
			<li>ShashlichnikMap_Cave</li>
		</targetTags>
		<baseChance>1.0</baseChance>
		<pointsScaleable>true</pointsScaleable>
		<category>ThreatBig</category>
		<tale>Raid</tale>
		<ignoreRecentSelectionWeighting>true</ignoreRecentSelectionWeighting>
		<canOccurOnAllPlanetLayers>true</canOccurOnAllPlanetLayers>
	</IncidentDef>

	<RaidStrategyDef ParentName="ImmediateAttack">
		<defName>ShashlichnikCaveRaid</defName>
		<workerClass>RaidStrategyWorker_ImmediateAttack</workerClass>
		<arriveModes Inherit="False">
			<li>ShashlichnikCaveEdgeWalkIn</li>
			<li>ShashlichnikCaveDrop</li>
		</arriveModes>
		<letterLabelEnemy>Raid</letterLabelEnemy>
		<arrivalTextEnemy>They are attacking immediately.</arrivalTextEnemy>
		<letterLabelFriendly>Friendlies</letterLabelFriendly>
		<arrivalTextFriendly>They are moving in to help you immediately.</arrivalTextFriendly>
	</RaidStrategyDef>

	<PawnsArrivalModeDef>
		<defName>ShashlichnikCaveEdgeWalkIn</defName>
		<workerClass>Shashlichnik.PawnsArrivalModeWorker_CaveEdgeWalkIn</workerClass>
		<selectionWeightCurve>
			<points>
				<li>(0, 1.0)</li>
				<li>(300, 1.0)</li>
				<li>(700, 0.4)</li>
			</points>
		</selectionWeightCurve>
		<textEnemy>A group of {0} from {1} have arrived nearby.</textEnemy>
		<textFriendly>A group of friendly {0} from {1} have arrived nearby.</textFriendly>
		<textWillArrive>{0_pawnsPluralDef} will arrive on foot.</textWillArrive>
		<walkIn>false</walkIn>
		<biomeWhitelist>
			<li>ShashlichnikUnderground</li>
		</biomeWhitelist>
	</PawnsArrivalModeDef>

	<PawnsArrivalModeDef>
		<defName>ShashlichnikCaveDrop</defName>
		<workerClass>Shashlichnik.PawnsArrivalModeWorker_CaveRoofDrop</workerClass>
		<selectionWeightCurve>
			<points>
				<li>(0, 1.0)</li>
				<li>(300, 1.0)</li>
				<li>(700, 0.4)</li>
			</points>
		</selectionWeightCurve>
		<textEnemy>A group of {0} from {1} falled nearby from the roof.</textEnemy>
		<textFriendly>A group of friendly {0} from {1} falled nearby from the roof.</textFriendly>
		<biomeWhitelist>
			<li>ShashlichnikUnderground</li>
		</biomeWhitelist>
	</PawnsArrivalModeDef>


	<IncidentDef>
		<defName>ShashlichnikCaveInfestation</defName>
		<label>infestation</label>
		<targetTags>
			<li>ShashlichnikMap_Cave</li>
		</targetTags>
		<workerClass>Shashlichnik.IncidentWorker_CaveInfestation</workerClass>
		<letterLabel>Infestation</letterLabel>
		<letterText>Giant insects are tunneling towards you! They will break through in a few seconds and plant hives.\n\nThe hives will spawn more insects and more hives.\n\nIf you don't want the insects to infest the whole area, destroy the hives. But beware - the bugs will defend their home.</letterText>
		<letterDef>ThreatBig</letterDef>
		<baseChance>2.7</baseChance>
		<minRefireDays>20</minRefireDays>
		<category>ThreatBig</category>
		<pointsScaleable>true</pointsScaleable>
		<minThreatPoints>180</minThreatPoints>
		<tale>Infestation</tale>
	</IncidentDef>
	
	<!--Population increase event-->

	<IncidentDef>
		<defName>ShashlichnikWandererJoin_FallRoof</defName>
		<label>join</label>
		<category>Misc</category>
		<targetTags>
			<li>ShashlichnikMap_Cave</li>
		</targetTags>
		<workerClass>IncidentWorker_GiveQuest</workerClass>
		<questScriptDef>ShashlichnikWandererJoin_RoofFall</questScriptDef>
		<baseChance>0.4</baseChance>
		<populationEffect>IncreaseEasy</populationEffect>
	</IncidentDef>
	
	<!--Helping incidents-->

	<IncidentDef>
		<defName>ShashlichnikInterestHint</defName>
		<label>strange noise</label>
		<category>Misc</category>
		<targetTags>
			<li>ShashlichnikMap_Cave</li>
		</targetTags>
		<workerClass>Shashlichnik.IncidentWorker_InterestHint</workerClass>
		<baseChance>2</baseChance>
	</IncidentDef>


	<IncidentDef MayRequire="Ludeon.RimWorld.Biotech">
		<defName>ShashlichnikCaveToxGas</defName>
		<label>tox gas</label>
		<targetTags>
			<li>ShashlichnikMap_Cave</li>
		</targetTags>
		<workerClass>Shashlichnik.IncidentWorker_CaveToxGas</workerClass>
		<letterLabel>Tox gas</letterLabel>
		<letterText>Dangerous toxic gas flows from the roof. Move your people away from it as soon as possible.</letterText>
		<letterDef>ThreatBig</letterDef>
		<baseChance>1.4</baseChance>
		<minRefireDays>15</minRefireDays>
		<category>ThreatBig</category>
		<!--<minThreatPoints>180</minThreatPoints>-->
		<!--<tale></tale>-->
	</IncidentDef>

</Defs>
